ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lifetracker:lifetracker@localhost:5432/lifetracker
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_USE_NULL_POOL=false
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=lifetracker-api
JWT_AUDIENCE=lifetracker-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
PASSWORD_RESET_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Optional locally; required in production for Forgot Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
