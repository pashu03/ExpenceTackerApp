# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://lifetracker:lifetracker@localhost:5432/lifetracker
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication
# Generate a unique value with at least 32 random characters.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=lifetracker-api
JWT_AUDIENCE=lifetracker-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Browser/API integration
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

