# Populate these values through the deployment platform's secret manager.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
JWT_SECRET=replace-with-a-new-production-secret-of-at-least-32-random-characters
COOKIE_SECURE=true
CORS_ORIGINS=["https://your-production-domain.example"]
NEXT_PUBLIC_API_URL=/api/v1
