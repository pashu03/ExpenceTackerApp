# Populate these values through the deployment platform's secret manager.
ENVIRONMENT=production
DATABASE_URL=replace-with-managed-postgresql-async-url
JWT_SECRET=replace-with-a-production-secret-of-at-least-32-random-characters
COOKIE_SECURE=true
CORS_ORIGINS=["https://replace-with-web-origin.example"]
NEXT_PUBLIC_API_URL=https://replace-with-api-origin.example/api/v1

