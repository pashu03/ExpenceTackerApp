# Populate these values through the deployment platform's secret manager.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_USE_NULL_POOL=true
JWT_SECRET=replace-with-a-new-production-secret-of-at-least-32-random-characters
COOKIE_SECURE=true
CORS_ORIGINS=["https://your-production-domain.example"]
NEXT_PUBLIC_API_URL=/api/v1
# Required for production password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@your-production-domain.example
SMTP_USE_TLS=true
